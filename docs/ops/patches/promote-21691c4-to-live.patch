+def _mean_rgb(path: str, vf: str) -> tuple[float, float, float]:
+    proc = subprocess.run(
+        [
+            "ffmpeg", "-v", "error", "-i", path, "-vf", vf,
+            "-frames:v", "1", "-f", "rawvideo", "pipe:1",
+        ],
+        check=True, capture_output=True,
+    )
+    buf = proc.stdout
+    n = len(buf) // 3
+    rs = gs = bs = 0
+    for i in range(0, len(buf), 3):
+        rs += buf[i]
+        gs += buf[i + 1]
+        bs += buf[i + 2]
+    return rs / n, gs / n, bs / n
