# Copy to /workspace/secrets/drive-oauth.env on the Pod (chmod 600).
# Then restart: env WEB_PORT=8888 DATA_DIR=/workspace/vmdata bash deploy/pod/start.sh
#
# Create the Web OAuth client in Google Cloud Console (NOT a service-account JSON key).
# Redirect URI must match exactly:
#   https://li25cvxk21j8jn-8888.proxy.runpod.net/api/drive/oauth/callback

VARIANT_DRIVE_OAUTH_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"
VARIANT_DRIVE_OAUTH_CLIENT_SECRET="REPLACE_ME"
VARIANT_DRIVE_OAUTH_REDIRECT_URI="https://li25cvxk21j8jn-8888.proxy.runpod.net/api/drive/oauth/callback"

# Optional: pin Drop Ledger spreadsheet id (else created via POST /api/drop-ledger/ensure
# and stored at /workspace/vmdata/drive/drop_sheet.json).
# VARIANT_DROP_SHEET_ID="your-spreadsheet-id"
